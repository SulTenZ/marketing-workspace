# Referensi saja; launcher Go tidak membaca file .env secara otomatis.
# Isi dua nilai wajib sesuai environment deployment yang benar.
APP_ENV=
APP_ORIGIN=

# Opsional. Jika diisi, nilainya harus valid; string kosong ditolak.
# HTTP_ADDR=127.0.0.1:8080
# REQUEST_TIMEOUT=10s
# LOG_LEVEL=info

# VERCEL_ENV disediakan platform; jika ada harus sama dengan APP_ENV.
# Jangan mengisi DATABASE_URL atau secrets pada M1-02.
# Cron/push belum tersedia; true ditolak sampai milestone terkait.
PUSH_ENABLED=false
CRON_ENABLED=false
